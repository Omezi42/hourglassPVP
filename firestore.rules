rules_version = '2';

// 砂時計PvP のFirestoreセキュリティルール。
//
// このファイルはリポジトリ内の記録であり、実際の適用はFirebaseコンソール
// (Firestore Database → ルール)へ貼り付けて公開する操作で行う。
// 「クライアントの操作をそのまま信頼し、サーバー側での正当性検証は行わない」という
// 方針(GameDesign.md 11章)のため、ここで守るのは次の2点だけとする。
//
//   1. 匿名サインイン済みでなければ一切読み書きできないこと
//   2. 対局・マッチングに使うコレクション以外へは書けないこと
//
// 意図的に検証していないこと(将来の不正対策で見直す範囲):
//   - 手(actions)の正当性。合法手かどうか、手番かどうかは見ない
//   - 対局者以外がmatches/{id}を読み書きできること。ルームコード対戦の観戦
//     (GameDesign.md 12章)が第三者による読み取りを前提としているため、
//     読み取りを対局者に限定していない
//   - キューやルームのドキュメントを他人が削除できること。切断して残ったキューを
//     他のプレイヤーが掃除する実装(MatchmakingQueue)がこれに依存している
//   - players/{uid}のcurrency(砂金)の増え方。本人しか書けないことだけを守り、
//     金額が正しいかどうかは検証しない(GameDesign.md 15章の「自分ひとりで
//     繰り返せる対局ほど報酬を低くする」という設計側の線引きで釣り合わせている)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ランダムマッチの待合室。ドキュメントIDはプレイヤーのuid。
    match /matchmaking_queue/{uid} {
      allow read, write: if signedIn();
    }

    // ランクマッチの待合室(GameDesign.md 28章)。フリーマッチのプールとは別に持つ。
    match /ranked_queue/{uid} {
      allow read, write: if signedIn();
    }

    // ルームコード対戦の部屋。ドキュメントIDは4桁の数字のルームコード。
    match /rooms/{code} {
      allow read, write: if signedIn();
    }

    // 対局そのもの(デッキ・配置・手順・結果)。リプレイと観戦もこれを読む。
    match /matches/{matchId} {
      allow read, write: if signedIn();
    }

    // デッキコードの預かり先(GameDesign.md 9章)。ドキュメントIDは8桁の数字。
    // 中身は「カードのidと枚数」だけで、誰のものかは持たない。受け取った相手が
    // 読めなければ機能しないため、読み取りはサインイン済みの全員へ許す。
    match /deckcodes/{code} {
      allow read, write: if signedIn();
    }

    // プレイヤーごとのアカウント情報(表示名・砂金の残高)。ドキュメントIDはuid。
    // 読み取りをサインイン済みの全員へ許すのは、対局中とリプレイ一覧で相手の
    // 表示名を出すため。書き込みは本人のみに限る(残高を他人に書き換えられると、
    // クライアントを信頼する方針の中でも被害が本人の記録に留まらないため)。
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // 分析用の対局記録(GameDesign.md 22章)。ドキュメントIDは match_id。
    // 対局した2人が同じIDへ書きにいき、先着1件だけが通る(exists:false)。
    // 消さないため delete は許さない。読み取りをサインイン済みの全員へ許すのは、
    // 記録を読んで集計する道具(tools/analyze_matches.py)も同じ経路を使うため。
    match /match_records/{matchId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // みんなの戦績の集計(同22章)。記録を書けた側だけが増分で更新する。
    // 正しく増えているかは検証しない(クライアントを信頼する方針。11章)。
    match /stats/{docId} {
      allow read, write: if signedIn();
    }

    // Discordアカウントとの連携コード(GameDesign.md 26章)。ドキュメントIDは8桁の数字。
    // deckcodesと同じ「預けたら消さない」引換券方式。読み取りはDiscord Bot(Admin SDK、
    // ルールの制約を受けない)が行うため本来クライアントには不要だが、9章のデッキコードと
    // 同様サインイン済みなら読めるようにしておく。
    match /discord_link_codes/{code} {
      allow read, write: if signedIn();
    }

    // Discordアカウント⇔ゲーム内uidの紐付け(同26章)。ドキュメントIDはDiscordの
    // ユーザーID。書き込みは `/link` を処理するCloud Functions(Admin SDK)からのみ行い、
    // クライアントには一切書かせない。
    match /discord_links/{discordUserId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 掲示板〈ラボ〉(GameDesign.md 29章 / Architecture.md 10.17節)。投票数で案を選ぶ仕組みは
    // 票の水増しを許すと成り立たないため、11章の「クライアントを信頼する」方針の例外として
    // 1回1人1件・1人3票・自分へは入れない・募集中だけ、をここで縛る。案と投票用紙の
    // ドキュメントIDは `{round_id}_{uid}`(どちらも英数字のみ)。
    function labRegistered() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('login_id', '') != '';
    }

    function labOpen(roundId) {
      let round = get(/databases/$(database)/documents/lab_rounds/$(roundId)).data;
      return request.time.toMillis() >= round.starts_at * 1000
        && request.time.toMillis() < round.ends_at * 1000;
    }

    function labProposal(proposalId) {
      return /databases/$(database)/documents/lab_proposals/$(proposalId);
    }

    function labBallot(roundId) {
      return /databases/$(database)/documents/lab_ballots/$(roundId + '_' + request.auth.uid);
    }

    // 回はお題の作成(管理ツール=Admin SDK)だけが書く。
    match /lab_rounds/{roundId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /lab_proposals/{proposalId} {
      allow read: if signedIn();

      allow create: if signedIn() && labRegistered()
        && request.resource.data.keys().hasOnly(['author_uid', 'round_id', 'card_name',
             'description', 'card_kind', 'hidden', 'good_count', 'result', 'source', 'created_at'])
        && request.resource.data.author_uid == request.auth.uid
        && proposalId == request.resource.data.round_id + '_' + request.auth.uid
        && request.resource.data.card_name is string
        && request.resource.data.card_name.size() <= 20
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.card_kind in ['hourglass', 'spell']
        && request.resource.data.hidden == false
        && request.resource.data.good_count == 0
        && request.resource.data.result == ''
        && request.resource.data.source == 'vote'
        && labOpen(request.resource.data.round_id);

      // 投票:good_count の+1だけ。同じ書き込みで自分の投票用紙にこの案が1件足されていること。
      allow update: if signedIn() && labRegistered()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['good_count'])
        && request.resource.data.good_count == resource.data.good_count + 1
        && resource.data.author_uid != request.auth.uid
        && resource.data.hidden == false
        && labOpen(resource.data.round_id)
        && getAfter(labBallot(resource.data.round_id)).data.last_id == proposalId
        && getAfter(labBallot(resource.data.round_id)).data.proposal_ids.size()
             == (exists(labBallot(resource.data.round_id))
                   ? get(labBallot(resource.data.round_id)).data.proposal_ids.size() : 0) + 1;

      allow delete: if false;
    }

    // 1回1人1枚の投票用紙。proposal_ids は「前の内容 + [last_id]」で3件まで。
    match /lab_ballots/{ballotId} {
      allow read: if signedIn() && ballotId.split('_')[1] == request.auth.uid;

      allow create: if signedIn() && labRegistered()
        && request.resource.data.keys().hasOnly(['voter_uid', 'round_id', 'proposal_ids', 'last_id'])
        && request.resource.data.voter_uid == request.auth.uid
        && ballotId == request.resource.data.round_id + '_' + request.auth.uid
        && request.resource.data.proposal_ids == [request.resource.data.last_id]
        && getAfter(labProposal(request.resource.data.last_id)).data.good_count
             == get(labProposal(request.resource.data.last_id)).data.good_count + 1
        && get(labProposal(request.resource.data.last_id)).data.round_id == request.resource.data.round_id;

      allow update: if signedIn() && labRegistered()
        && request.resource.data.keys().hasOnly(['voter_uid', 'round_id', 'proposal_ids', 'last_id'])
        && request.resource.data.voter_uid == request.auth.uid
        && request.resource.data.round_id == resource.data.round_id
        && request.resource.data.proposal_ids
             == resource.data.proposal_ids.concat([request.resource.data.last_id])
        && request.resource.data.proposal_ids.size() <= 3
        && !(request.resource.data.last_id in resource.data.proposal_ids)
        && getAfter(labProposal(request.resource.data.last_id)).data.good_count
             == get(labProposal(request.resource.data.last_id)).data.good_count + 1
        && get(labProposal(request.resource.data.last_id)).data.round_id == request.resource.data.round_id;

      allow delete: if false;
    }

    // カードスポットライトが直近30日の重複を避けるための最終紹介日時(同26章)。
    // ドキュメントIDはカードid。Cloud Scheduler経由のCloud Functions(Admin SDK)だけが
    // 触るため、クライアントには読み書きさせない。
    match /bot_spotlight_history/{cardId} {
      allow read, write: if false;
    }

    // 上記以外は一切許可しない。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
