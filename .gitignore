# Godot 4+ specific ignores
.godot/
/android/

# ビルド成果物(エクスポートで再生成できるため管理しない)
/build/

# 作業ログ・一時ファイル
/logs/
/scratchpad/
*.bak

# Claude Code のローカル状態(共有しない)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# アセットの元データ(.gdignore済み・実行時に読まないためリポジトリには含めない)
# ローカルには残るが、リポジトリを軽く保つため管理対象外とする
/assets/hourglasses/sources/
/assets/hourglasses/processed_backup/
/assets/hourglasses/incoming/
/assets/ui/incoming/
/assets/buttons/incoming/
/assets/backgrounds/incoming/

# バランス調整シミュレーションの出力(再生成可能)
/tools/balance/out/

# アイコンの取り込み元(素材そのものの再配布を避けるため除外する)
assets/hourglasses/emblems/sources/

# お知らせのたびに作り直す画像(生成物のため管理しない)
/assets/mascot/update_banner.png
/assets/mascot/card_*.png
/assets/mascot/effect_*.gif

# Discordの通知先。公開リポジトリへ入れるとGitHubのsecret scanningが検出し、
# Discord側がWebhookを自動的に無効化するため管理しない。
# エクスポートはgitではなくファイルシステムを見るため、これでもpckには入る。
/data/discord_webhook.txt
