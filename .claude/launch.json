{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-build",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8073",
        "--directory",
        "build/web"
      ],
      "port": 8073
    },
    {
      "name": "card-tuner",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "tools/card_tuner/server.py"
      ],
      "port": 8790,
      "autoPort": true
    },
    {
      "name": "web-test",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8074",
        "--directory",
        "scratchpad/webtest"
      ],
      "port": 8074
    },
    {
      "name": "app-build",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8075",
        "--directory",
        "build/app"
      ],
      "port": 8075
    }
  ]
}
