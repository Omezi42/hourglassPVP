[gd_resource type="Resource" script_class="SoloStageData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/solo_stage_data.gd" id="script_stage"]
[ext_resource type="Script" path="res://scripts/data/solo_match_config.gd" id="script_config"]

[sub_resource type="Resource" id="config"]
script = ExtResource("script_config")
player_deck_ids = Array[String](["grain", "grain", "wand", "wand", "sand", "sand", "shield", "shield", "dash", "dash", "pebble", "pebble", "forge", "forge", "echo", "echo", "sword", "sword", "glass", "glass", "drill", "drill", "lance", "lance", "twin", "twin", "guard", "guard", "wall", "wall"])
opponent_deck_ids = Array[String](["grain", "grain", "glim", "glim", "wand", "wand", "sand", "sand", "tick", "tick", "dash", "dash", "salt", "salt", "spike", "spike", "hour", "hour", "sword", "sword", "drill", "drill", "barb", "barb", "lance", "lance", "pike", "pike", "poison", "poison"])
opponent_count = 1
own_board_units = Array[String]([])
foe_board_units = Array[String]([])
win_condition = 0
survive_turns = 0
sand_drop_count = 1
hp_override = 0
mana_frozen = false
flip_disabled = false
clash_damage_multiplier = 1

[resource]
script = ExtResource("script_stage")
id = "solo_2"
order = 2
display_name = "上級との立ち合い"
description = "上級の思考を持つCPUと、通常のルールで1局。固定デッキで正面から撃ち合う。"
stage_type = 1
requires = Array[String](["solo_1"])
reward_gold = 60
reward_icon_id = ""
reward_card_set_id = ""
match_config = SubResource("config")
