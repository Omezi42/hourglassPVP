[gd_resource type="Resource" script_class="SoloStageData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/solo_stage_data.gd" id="script_stage"]
[ext_resource type="Script" path="res://scripts/data/solo_match_config.gd" id="script_config"]

[sub_resource type="Resource" id="config"]
script = ExtResource("script_config")
player_deck_ids = Array[String](["grain", "grain", "wand", "wand", "sand", "sand", "dash", "dash", "shield", "shield", "forge", "forge", "sword", "sword", "echo", "echo", "glass", "glass", "drill", "drill", "lance", "lance", "twin", "twin", "pike", "pike", "guard", "guard", "wall", "wall"])
opponent_deck_ids = Array[String](["grain", "grain", "glim", "glim", "wand", "wand", "sand", "sand", "tick", "tick", "dash", "dash", "salt", "salt", "spike", "spike", "hour", "hour", "sword", "sword", "drill", "drill", "barb", "barb", "lance", "lance", "poison", "poison", "tower", "tower"])
opponent_count = 1
own_board_units = Array[String]([])
foe_board_units = Array[String](["guard:4:3", "drill:5:2"])
win_condition = 0
survive_turns = 0
sand_drop_count = 2
hp_override = 20
mana_frozen = false
flip_disabled = false
clash_damage_multiplier = 2

[resource]
script = ExtResource("script_stage")
id = "solo_10"
order = 10
display_name = "砂時計の底"
description = "砂は2粒ずつ落ち、相打ちの傷は倍になる。HP20から始まる最終戦。"
stage_type = 2
requires = Array[String](["solo_9"])
reward_gold = 200
reward_icon_id = ""
reward_card_set_id = "solo_goad"
match_config = SubResource("config")
