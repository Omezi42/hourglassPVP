[gd_resource type="Resource" script_class="SoloStageData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/solo_stage_data.gd" id="script_stage"]
[ext_resource type="Script" path="res://scripts/data/solo_match_config.gd" id="script_config"]

[sub_resource type="Resource" id="config"]
script = ExtResource("script_config")
player_deck_ids = Array[String](["grain", "grain", "wand", "wand", "glim", "glim", "sand", "sand", "dash", "dash", "tick", "tick", "salt", "salt", "sword", "sword", "drill", "drill", "vamp", "vamp", "lance", "lance", "swarm", "swarm", "twin", "twin", "pike", "pike", "wheel", "wheel"])
opponent_deck_ids = Array[String](["grain", "grain", "seed", "seed", "wand", "wand", "sand", "sand", "dash", "dash", "spike", "spike", "hour", "hour", "sword", "sword", "echo", "echo", "drill", "drill", "barb", "barb", "lance", "lance", "twin", "twin", "poison", "poison", "tower", "tower"])
opponent_count = 1
own_board_units = Array[String]([])
foe_board_units = Array[String]([])
win_condition = 0
survive_turns = 0
sand_drop_count = 2
hp_override = 0
mana_frozen = false
flip_disabled = false
clash_damage_multiplier = 1

[resource]
script = ExtResource("script_stage")
id = "solo_7"
order = 7
display_name = "第7階 早すぎる落下"
description = "毎ターン砂が2粒落ちる。すべてが半分の寿命で進み、盤面は一瞬で入れ替わる。"
stage_type = 2
requires = Array[String](["solo_6"])
reward_gold = 100
reward_icon_id = ""
reward_card_set_id = ""
match_config = SubResource("config")
