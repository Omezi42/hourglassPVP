[gd_resource type="Resource" script_class="SoloStageData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/solo_stage_data.gd" id="script_stage"]
[ext_resource type="Script" path="res://scripts/data/solo_match_config.gd" id="script_config"]

[sub_resource type="Resource" id="config"]
script = ExtResource("script_config")
player_deck_ids = Array[String](["grain", "grain", "husk", "husk", "shield", "shield", "watcher", "watcher", "glass", "glass", "crown", "crown", "gust", "gust", "shatter", "shatter", "hammer", "hammer", "tempest", "tempest", "gate", "gate", "guard", "guard", "mirror", "mirror", "wall", "wall", "tower", "tower"])
opponent_deck_ids = Array[String](["grain", "grain", "glim", "glim", "wand", "wand", "seed", "seed", "dash", "dash", "tick", "tick", "salt", "salt", "sand", "sand", "spike", "spike", "sword", "sword", "drill", "drill", "barb", "barb", "lance", "lance", "twin", "twin", "swarm", "swarm"])
opponent_count = 1
own_board_units = Array[String](["gate:9:0"])
foe_board_units = Array[String](["shield:3:0", "sand:4:0", "glass:5:0"])
win_condition = 0
survive_turns = 0
sand_drop_count = 1
hp_override = 12
mana_frozen = false
flip_disabled = false
clash_damage_multiplier = 1

[resource]
script = ExtResource("script_stage")
id = "solo_4"
order = 4
display_name = "半分の砂"
description = "互いのHPが12から始まる。相手は先に3体を展開しているが、こちらには攻撃できない守護の壁が1体ある。受けて捌く。"
stage_type = 2
requires = Array[String](["solo_3"])
reward_gold = 80
reward_icon_id = ""
reward_card_set_id = ""
match_config = SubResource("config")
