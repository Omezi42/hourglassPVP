[gd_resource type="Resource" script_class="SoloStageData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/solo_stage_data.gd" id="script_stage"]
[ext_resource type="Script" path="res://scripts/data/solo_match_config.gd" id="script_config"]

[sub_resource type="Resource" id="config"]
script = ExtResource("script_config")
player_deck_ids = Array[String](["grain", "grain", "wand", "wand", "sand", "sand", "shield", "shield", "dash", "dash", "pebble", "pebble", "forge", "forge", "pivot", "pivot", "echo", "echo", "sword", "sword", "glass", "glass", "drill", "drill", "eye", "eye", "guard", "guard", "wall", "wall"])
opponent_deck_ids = Array[String](["grain", "grain", "glim", "glim", "seed", "seed", "sand", "sand", "salt", "salt", "dash", "dash", "spike", "spike", "hour", "hour", "sword", "sword", "drill", "drill", "barb", "barb", "lance", "lance", "pike", "pike", "poison", "poison", "tower", "tower"])
opponent_count = 1
own_board_units = Array[String]([])
foe_board_units = Array[String]([])
win_condition = 0
survive_turns = 0
sand_drop_count = 1
hp_override = 0
mana_frozen = false
flip_disabled = true
clash_damage_multiplier = 1

[resource]
script = ExtResource("script_stage")
id = "solo_6"
order = 6
display_name = "第6階 返せない砂"
description = "通常の反転が封じられる。入れ替えるなら効果か、反転権のいずれかで。"
stage_type = 4
requires = Array[String](["solo_5"])
reward_gold = 100
reward_icon_id = ""
reward_card_set_id = ""
match_config = SubResource("config")
